# Local: http://localhost:8080 | Railway: https://backend-locus-production.up.railway.app
VITE_API_URL=https://backend-locus-production.up.railway.app
VITE_BACKEND_USER_ID=1

# Google Maps JavaScript API: usada para localizar a panorâmica mais próxima
# em 50 m, 5 km, 10 km e 15 km antes de abrir o iframe do Street View.
# Use uma chave de navegador com restrição HTTP referrer, por exemplo:
# http://localhost:5173/*, http://127.0.0.1:5173/* e o domínio publicado.
# A conta do Google Cloud precisa estar vinculada a faturamento.
VITE_GOOGLE_MAPS_EMBED_ENABLED=true
VITE_GOOGLE_MAPS_API_KEY=
# Chave da Maps Embed API, usada pelos iframes de mapa e Street View no modal.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
# Alias aceito quando a variável foi criada como GOOGLE_MAPS_EMBED_API.
VITE_GOOGLE_MAPS_EMBED_API=

# Câmbio de referência usado nas estimativas exibidas pela IA.
# O backend salva os valores do orçamento em BRL.
VITE_USD_BRL_RATE=5.75
VITE_EUR_BRL_RATE=6.20

# Firebase Authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
