# Local: http://localhost:8080 | Railway: https://backend-locus-production.up.railway.app
VITE_API_URL=https://backend-locus-production.up.railway.app
VITE_BACKEND_USER_ID=1

# O mapa e o Street View passam pelo backend para não expor a chave de servidor.
# Não é necessário configurar chave do Google no frontend.
VITE_GOOGLE_MAPS_EMBED_ENABLED=false

# Firebase Authentication
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
